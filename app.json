{
  "expo": {
    "name": "Chefness",
    "slug": "chefness",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "chefness",
    "userInterfaceStyle": "light",
    "icon": "./public/pwa-1024x1024.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.maxpaulus.chefness",
      "buildNumber": "5",
      "appleTeamId": "WNCJFCHP22",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Chefness uses the camera to let you share food and ingredient photos with your cooking assistant.",
        "NSPhotoLibraryUsageDescription": "Chefness uses your photo library to attach food and ingredient photos to chats.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        }
      }
    },
    "plugins": [
      "./plugins/with-ios-pods-deployment-target.cjs",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Chefness uses the microphone to turn your speech into chat text.",
          "speechRecognitionPermission": "Chefness uses Apple's speech recognition to turn your speech into chat text."
        }
      ],
      [
        "expo-share-extension",
        {
          "activationRules": [{ "type": "url", "max": 1 }],
          "height": 280,
          "backgroundColor": {
            "red": 250,
            "green": 247,
            "blue": 242,
            "alpha": 1
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose food and ingredient photos to share with your cooking assistant.",
          "cameraPermission": "Take food and ingredient photos to share with your cooking assistant."
        }
      ],
      "expo-font",
      "./plugins/with-ios-scene-lifecycle.cjs",
      "expo-secure-store",
      "expo-iap"
    ]
  }
}
